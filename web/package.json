{
  "name": "financial-bot-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:ui": "vite",
    "dev:server": "tsx watch server/index.ts",
    "dev": "concurrently -n \"API,UI\" -c \"blue,green\" \"tsx watch server/index.ts\" \"vite\"",
    "build:ui": "vite build",
    "build:offline": "BUILD_OFFLINE=true vite build",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "lint": "oxlint",
    "fmt": "oxfmt"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.19",
    "chart.js": "^4.6.1",
    "culori": "^4.0.2",
    "hono": "^4.13.18",
    "katex": "^0.18.10",
    "lucide-vue-next": "^0.475.0",
    "marked": "^15.0.12",
    "marked-katex-extension": "^5.1.13",
    "mermaid": "^11.17.2",
    "papaparse": "^5.7.1",
    "vue": "^3.5.45",
    "vue-chartjs": "^5.3.4"
  },
  "devDependencies": {
    "@types/culori": "^4.0.1",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@vitejs/plugin-vue": "^5.2.4",
    "autoprefixer": "^10.6.2",
    "concurrently": "^9.2.5",
    "daisyui": "^4.12.24",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.93.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vite-plugin-singlefile": "^2.3.4",
    "vue-tsc": "^2.2.12"
