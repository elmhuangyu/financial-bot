{
  "name": "financial-bot-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:ui": "vite",
    "dev:server": "tsx watch server/index.ts",
    "dev": "concurrently -n \"API,UI\" -c \"blue,green\" \"tsx watch server/index.ts\" \"vite\"",
    "build:ui": "vite build",
    "build:offline": "BUILD_OFFLINE=true vite build",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "lint": "oxlint",
    "fmt": "oxfmt"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "chart.js": "^4.4.8",
    "hono": "^4.7.2",
    "katex": "^0.18.4",
    "lucide-vue-next": "^0.475.0",
    "marked": "^15.0.7",
    "marked-katex-extension": "^5.1.12",
    "mermaid": "^11.17.1",
    "papaparse": "^5.5.2",
    "vue": "^3.5.13",
    "vue-chartjs": "^5.3.2"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^22.13.5",
    "@types/papaparse": "^5.3.15",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "daisyui": "^4.12.23",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.1",
    "vite-plugin-singlefile": "^2.1.0",
    "vue-tsc": "^2.2.4"
  }
